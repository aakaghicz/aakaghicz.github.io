
---
import Base from "../layouts/Base.astro";
---

<Base title="Contact — Notes by Amila">
  <main class="container">
    <section class="contact-page">
      <div class="eyebrow">LET'S CONNECT</div>
      <h1>Get in touch</h1>
      <p class="contact-intro">
        Whether you have a thought about something I've written,
        a question, or simply want to say hello,
        I'd be happy to hear from you.
      </p>

      <form
        action="https://formspree.io/f/xbggazoj"
        method="POST"
        class="contact-form"
      >
        <label for="name">Your name</label>
        <input id="name" name="name" required />

        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          required
        />

        <label for="message">Your message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
        ></textarea>

        <button type="submit">Send message</button>
      </form>
    </section>
  </main>
</Base>

<style>
  .contact-page {
    max-width: 660px;
    margin: 75px auto 110px;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: clamp(2.4rem, 5vw, 3.5rem);
  }

  .contact-intro {
    color: #746A73;
    line-height: 1.8;
    margin-bottom: 36px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  input, textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 15px;
    border: 1px solid #EADDE2;
    border-radius: 5px;
    background: #fff;
    color: #302935;
    font: inherit;
  }

  input:focus, textarea:focus {
    outline: 2px solid #D93672;
    outline-offset: 2px;
  }

  button {
    align-self: flex-start;
    background: #D93672;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 13px 28px;
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    background: #B92B62;
  }
</style>
